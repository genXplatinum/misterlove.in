{
  "name": "lovepreet-singh",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The personal site and Living Archive of Lovepreet Singh, cybersecurity professional, Lovelace founder, scholar, researcher and writer.",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:hindi && npm run validate:forgotten-gods-hindi && npm run og",
    "build": "vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "og": "node scripts/make-og-cards.mjs",
    "og:hindi": "node scripts/make-og-cards.mjs --hindi-only",
    "validate:hindi": "node scripts/validate-hindi-writing.mjs",
    "validate:forgotten-gods-hindi": "node scripts/validate-forgotten-gods-hindi.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "vite": "^8.1.0"
  }
}
