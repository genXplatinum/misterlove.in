{
  "name": "lovepreet-singh",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The personal site and Living Archive of Lovepreet Singh, cybersecurity professional, Lovelace founder, scholar, researcher and writer.",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:hindi && npm run validate:forgotten-gods-hindi && npm run validate:women-hindi && npm run validate:sikhism && npm run og",
    "build": "vite build",
    "postbuild": "node scripts/postbuild.mjs && node scripts/validate-press.mjs",
    "og": "node scripts/make-og-cards.mjs && node scripts/make-press-cards.mjs",
    "og:hindi": "node scripts/make-og-cards.mjs --hindi-only",
    "social:india": "node scripts/make-india-instagram-carousel.mjs",
    "validate:hindi": "node scripts/validate-hindi-writing.mjs",
    "validate:forgotten-gods-hindi": "node scripts/validate-forgotten-gods-hindi.mjs",
    "validate:women-hindi": "node scripts/validate-rules-about-women-hindi.mjs",
    "validate:sikhism": "node scripts/validate-sikhism-completion.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:local": "npm run validate:hindi && npm run validate:forgotten-gods-hindi && npm run validate:women-hindi && vite build && node scripts/postbuild.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "harfbuzzjs": "1.6.2",
    "jpeg-js": "^0.4.4",
    "mupdf": "^1.28.0",
    "oxlint": "^1.69.0",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "vite": "^8.1.0"
  }
}
